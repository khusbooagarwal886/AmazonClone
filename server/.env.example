# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/amazon-clone?retryWrites=true&w=majority

# URLs for CORS and Swagger (supports comma-separated origins)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Redis Caching (Upstash Redis or local redis://localhost:6379)
REDIS_URL=rediss://default:your_password@your_endpoint.upstash.io:6379

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

