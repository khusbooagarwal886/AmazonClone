# Dependencies (downloaded locally via npm install; never track in git)
node_modules/

# Environment variables & secrets (contains sensitive API keys, DB credentials)
.env
.env.*
!.env.example

# Production build outputs (generated by tsc/vite; derived files should not be committed)
dist/
build/

# Logs (runtime outputs and debug logs)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System & IDE specific files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Test coverage reports
coverage/
.nyc_output/
